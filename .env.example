# URL API khi web và API khác origin (để trống = cùng origin / đi qua proxy Vite khi dev)
VITE_API_URL=
# multi | single — để trống thì tự phát hiện qua GET /health
VITE_TENANT_MODE=
# Hiện nhóm menu Hệ thống (SYS) — luồng đăng nhập SYS chưa có
VITE_SHOW_SYS=false
# Đích proxy khi chạy `npm run dev`
VITE_DEV_PROXY_TARGET=http://localhost:3969
